system:
    db: sqlite
    listenAddr: "0.0.0.0:8088"

gateway:
    api-key: "sk-change-me"
    admin-key: "sk-admin-change-me"
    upstream: "https://copilot.tencent.com"
    gzip: true
    passthrough: true
    inject-reasoning: false
    timeout-seconds: 300
    max-retries: 3
    # 选号模式：sticky（同模型粘号）/ least_used / round_robin。
    # 无论哪种模式，都会先按「实测成本」过滤候选——优先挑跑该模型不花钱的号。
    # 成本从响应 usage.credit 实测得出（各账号在同一模型上的计费并不一致），
    # 观测 6 小时过期，避免夜间免费的号白天仍被当成免费。
    # 同一模型粘在一个号上吃缓存；额度/模型配额用尽再切下一个。
    rotate: sticky
    trust-env-proxy: false
    proxy: ""
    model-alias:
        - from: gpt-4
          to: glm-5.1
        - from: gpt-4o
          to: glm-5.2
        - from: gpt-3.5-turbo
          to: glm-5.0-turbo
    # Codex Desktop 会额外请求 gpt-5.6-luna 等 OpenAI 托管模型。
    # 留空则自动落到最近一次成功的上游模型，再不行用 deepseek-v4.1-flash。
    fallback-model: ""
    # 发往上游前的请求清洗力度（应对 11128 "unapproved channel"）。
    # 默认值就是推荐值，通常不需要改——装上即用，写代码不被打断：
    #   harness（默认）— 覆盖全部常见触发面：客户端模板（system/developer）、harness 注入的
    #                    user 上下文、tool 定义，以及随会话累积的 assistant 历史与 tool 输出。
    #                    后两者只做不可见脱敏（零宽），不删改任何文字，用户无感。
    #   full          — 额外允许删除被污染的模板文本（句子级剪枝）。被 11128 拒绝时自动升到这档。
    #   off           — 关闭清洗，仅用于排障对比。
    sanitize-mode: "harness"

codebuddy:
    ide-type: CodeBuddyIDE
    ide-version: "4.9.7"
    product-version: "4.9.7"
    product: SaaS
    domain: www.codebuddy.cn
    env-id: production
    agent-intent: craft
    default-max-tokens: 32000
    billing-base: "https://www.codebuddy.cn"

refresh:
    enabled: true
    cron: "0 3 * * *"
    threshold-days: 30
    timeout-seconds: 15

watchdog:
    enabled: true
    interval-seconds: 300
    fail-threshold: 3
    cooldown-seconds: 600
    health-check: true
    # sync-credit 只控制「是否打上游接口拉取额度」。
    # 状态收敛（有额度→启用、无额度→冷却）始终执行，用库里已有的额度数据，
    # 关掉它不会让账号卡在错误状态上。
    sync-credit: true

sqlite:
    path: data/gateway.db
    prefix: ""
    singular: false
    log-mode: error
    max-idle-conns: 10
    max-open-conns: 100
    log-zap: false

mysql:
    path: 127.0.0.1
    port: "3306"
    config: charset=utf8mb4&parseTime=True&loc=Local
    db-name: codebuddy_gateway
    username: root
    password: ""
    prefix: ""
    engine: ""
    charset: utf8mb4
    log-mode: error
    max-idle-conns: 10
    max-open-conns: 100
    singular: false
    log-zap: false

pgsql:
    path: 127.0.0.1
    port: "5432"
    config: sslmode=disable TimeZone=UTC
    db-name: codebuddy_gateway
    username: postgres
    password: ""
    prefix: ""
    engine: ""
    log-mode: error
    max-idle-conns: 10
    max-open-conns: 100
    singular: false
    log-zap: false

zap:
    level: info
    prefix: '[CodeBuddyGateway]'
    format: console
    director: log
    encode-level: LowercaseColorLevelEncoder
    stacktrace-key: stacktrace
    show-line: true
    log-in-console: true
    retention-day: -1

dashboard:
    title: CodeBuddy2API 控制台
    # 面板登录密码，留空表示只校验 admin-key。写入时自动转成 sha256: 摘要。
    password: ""
    # 是否同时校验 admin-key；关掉之前必须先设置面板密码。
    require-admin-key: true
