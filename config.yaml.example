system:
    db: sqlite
    listenAddr: "0.0.0.0:8088"

gateway:
    api-key: "sk-change-me"
    admin-key: "sk-admin-change-me"
    upstream: "https://copilot.tencent.com"
    gzip: true
    passthrough: true
    inject-reasoning: false
    timeout-seconds: 300
    max-retries: 3
    rotate: sticky  # 同一模型粘在一个号上吃缓存；额度/模型配额用尽再切下一个
    trust-env-proxy: false
    proxy: ""
    model-alias:
        - from: gpt-4
          to: glm-5.1
        - from: gpt-4o
          to: glm-5.2
        - from: gpt-3.5-turbo
          to: glm-5.0-turbo
    # Codex Desktop 会额外请求 gpt-5.6-luna 等 OpenAI 托管模型。
    # 留空则自动落到最近一次成功的上游模型，再不行用 deepseek-v4.1-flash。
    fallback-model: ""

codebuddy:
    ide-type: CodeBuddyIDE
    ide-version: "4.9.7"
    product-version: "4.9.7"
    product: SaaS
    domain: www.codebuddy.cn
    env-id: production
    agent-intent: craft
    default-max-tokens: 32000
    billing-base: "https://www.codebuddy.cn"

refresh:
    enabled: true
    cron: "0 3 * * *"
    threshold-days: 30
    timeout-seconds: 15

watchdog:
    enabled: true
    interval-seconds: 300
    fail-threshold: 3
    cooldown-seconds: 600
    health-check: true
    sync-credit: true

sqlite:
    path: data/gateway.db
    prefix: ""
    singular: false
    log-mode: error
    max-idle-conns: 10
    max-open-conns: 100
    log-zap: false

mysql:
    path: 127.0.0.1
    port: "3306"
    config: charset=utf8mb4&parseTime=True&loc=Local
    db-name: codebuddy_gateway
    username: root
    password: ""
    prefix: ""
    engine: ""
    charset: utf8mb4
    log-mode: error
    max-idle-conns: 10
    max-open-conns: 100
    singular: false
    log-zap: false

pgsql:
    path: 127.0.0.1
    port: "5432"
    config: sslmode=disable TimeZone=UTC
    db-name: codebuddy_gateway
    username: postgres
    password: ""
    prefix: ""
    engine: ""
    log-mode: error
    max-idle-conns: 10
    max-open-conns: 100
    singular: false
    log-zap: false

zap:
    level: info
    prefix: '[CodeBuddyGateway]'
    format: console
    director: log
    encode-level: LowercaseColorLevelEncoder
    stacktrace-key: stacktrace
    show-line: true
    log-in-console: true
    retention-day: -1

dashboard:
    title: CodeBuddy2API 控制台
    # 面板登录密码，留空表示只校验 admin-key。写入时自动转成 sha256: 摘要。
    password: ""
    # 是否同时校验 admin-key；关掉之前必须先设置面板密码。
    require-admin-key: true
